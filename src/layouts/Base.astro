---
import '@fontsource-variable/inter-tight/wght.css';
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource/jetbrains-mono/400.css';
import '../styles/global.css';
import SiteNav from '../components/SiteNav.astro';
import { SITE } from '../site';

interface Props {
  title?: string;
  description?: string;
  home?: boolean;
}
const { title, description = SITE.description, home = false } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;
---
<!doctype html>
<html lang="en" class={home ? 'is-home' : ''}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0a0b" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <slot name="head" />
    {/* Google Analytics. Only on the built site, so local previews are not counted as visits. */}
    {import.meta.env.PROD && (
      <>
        <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-5K4BYRTPE1"></script>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', 'G-5K4BYRTPE1');
        </script>
      </>
    )}
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
    </script>
  </head>
  <body>
    <SiteNav />
    <main class={home ? '' : 'page wrap'}>
      <slot />
    </main>
    <footer class="foot">
      <span class="mono">© {new Date().getFullYear()} {SITE.name}</span>
      <div>
        {SITE.links.map((l) => <a class="mono" href={l.href}>{l.label}</a>)}
        <a class="mono" href={`mailto:${SITE.email}`}>Email</a>
        <a class="mono" href="/rss.xml">RSS</a>
      </div>
    </footer>
  </body>
</html>
<script>
  import '../scripts/chrome';
  import '../scripts/cursor';
</script>
