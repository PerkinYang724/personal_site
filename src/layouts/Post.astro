---
// The Chinese font's stylesheets are large, so they are linked only on bilingual posts.
import zh400 from '@fontsource/noto-serif-tc/400.css?url';
import zh600 from '@fontsource/noto-serif-tc/600.css?url';
import Base from './Base.astro';
import { formatDate } from '../utils';

interface Props {
  title: string;
  // Set on bilingual posts: the Chinese title. Turns on the two-language header and the language switch.
  titleZh?: string;
  description?: string;
  date: Date;
  tags?: string[];
  kicker?: string;
}
const { title, titleZh, description, date, tags = [], kicker } = Astro.props;
---
<Base title={title} description={description}>
  {titleZh && <Fragment slot="head"><link rel="stylesheet" href={zh400} /><link rel="stylesheet" href={zh600} /></Fragment>}
  <article class:list={['prose', titleZh && 'prose-bi']} data-lang={titleZh ? 'both' : undefined}>
    <div class="mono dim meta">
      {kicker && <span>{kicker}</span>}
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      {tags.length > 0 && <span>{tags.join(' / ')}</span>}
      {titleZh && <span>中文 / English</span>}
    </div>
    {titleZh ? (
      <>
        <h1 lang="zh-Hant">{titleZh}</h1>
        <p class="bi-sub" lang="en">{title}</p>
        <div class="lang-toggle" role="group" aria-label="Reading language">
          <button type="button" data-set-lang="both" aria-pressed="true">雙語 Both</button>
          <button type="button" data-set-lang="zh" aria-pressed="false">中文</button>
          <button type="button" data-set-lang="en" aria-pressed="false">English</button>
        </div>
      </>
    ) : (
      <>
        <h1>{title}</h1>
        {description && <p class="lede serif">{description}</p>}
      </>
    )}
    <slot />
  </article>
  <slot name="after" />
</Base>
{titleZh && (
  <script is:inline>
    (() => {
      const article = document.querySelector('.prose-bi');
      const buttons = article.querySelectorAll('[data-set-lang]');
      const apply = (lang) => {
        article.dataset.lang = lang;
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.setLang === lang)));
      };
      let saved = null;
      try { saved = localStorage.getItem('reading-lang'); } catch {}
      if (saved === 'zh' || saved === 'en') apply(saved);
      buttons.forEach((b) =>
        b.addEventListener('click', () => {
          apply(b.dataset.setLang);
          try { localStorage.setItem('reading-lang', b.dataset.setLang); } catch {}
        }),
      );
    })();
  </script>
)}
