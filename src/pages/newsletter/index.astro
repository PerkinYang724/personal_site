---
import Base from '../../layouts/Base.astro';
import NewsletterCta from '../../components/NewsletterCta.astro';
import { formatDate, getPosts } from '../../utils';

const posts = await getPosts('newsletter');
---
<Base title="Newsletter">
  <h1>Newsletter</h1>
  <p class="lede">Every past issue, archived.</p>
  <h2>{posts.length} {posts.length === 1 ? 'entry' : 'entries'}</h2>
  <ul class="list">
    {posts.map((p) => (
      <li><a href={`/newsletter/${p.id}/`}>{p.data.title}</a><time>{formatDate(p.data.date)}</time></li>
    ))}
  </ul>
  <NewsletterCta />
</Base>
