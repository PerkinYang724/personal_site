---
import { render } from 'astro:content';
import VideoFeed from '../../components/VideoFeed.astro';
import Post from '../../layouts/Post.astro';
import { getProjects } from '../../utils';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}
const { project } = Astro.props;
const { Content } = await render(project);
const { url, repo, status, videos = [], videosHeading } = project.data;
---
<Post {...project.data} kicker={status}>
  {(url || repo) && (
    <p>
      {url && <a class="btn-light mono" href={url}>Visit project</a>}
      {repo && <a href={repo} class="mono" style="margin-left: 1rem">Source code →</a>}
    </p>
  )}
  <Content />
  {videos.length > 0 && <VideoFeed slot="after" videos={videos} heading={videosHeading} channel={url} />}
</Post>
