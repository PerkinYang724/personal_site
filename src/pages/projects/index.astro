---
import Base from '../../layouts/Base.astro';
import { getProjects } from '../../utils';

const projects = await getProjects();
---
<Base title="Projects">
  <header class="page-head">
    <span class="mono dim">The work / {String(projects.length).padStart(2, '0')}</span>
    <p class="serif">Things I've built, shipped and tinkered with</p>
    <h1>Projects</h1>
  </header>
  <div class="cards">
    {projects.map((p) => (
      <a class="card" href={`/projects/${p.id}/`}>
        <span class="mono dim">{p.data.category} / {p.data.status}</span>
        <h3 class="serif">{p.data.title}</h3>
        <p class="dim">{p.data.description}</p>
        <span class="mono card-go">Open →</span>
      </a>
    ))}
  </div>
</Base>
