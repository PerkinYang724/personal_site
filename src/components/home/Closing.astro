---
import { HOME } from '../../data/home';
import { SITE } from '../../site';
const { closing: c } = HOME;
---
<section class="closing" data-closing>
  <canvas class="heat" data-heat aria-hidden="true"></canvas>
  <div class="closing-shade"></div>
  <div class="popup mono" data-popup aria-hidden="true" data-labels={JSON.stringify(c.popups)}>
    <div class="popup-head dim">Signal alert <i>×</i></div>
    <b data-popup-title>Idea</b>
    <span class="dim">Caught mid-thought</span>
    <span class="dim">Filed for draft two</span>
    <em class="hot">Worth writing about</em>
  </div>
  <div class="closing-center">
    <div class="sig-list mono" data-signals="up">
      <b class="sig-head">■ {c.listHeading}</b>
      <div class="sig-window"><ul>{[...c.signals, ...c.signals].map(([a, b]) => <li><i></i>{a} <span class="dim">/ {b}</span></li>)}</ul></div>
    </div>
    <div class="closing-copy">
      <span class="pill mono">{c.start}</span>
      <p class="serif">{c.serif}</p>
      <h2 class="clip-up"><span data-rise>{c.headline}</span></h2>
      <div class="closing-btns">
        <a class="mono" data-scramble href={`mailto:${SITE.email}`}>{c.secondary}</a>
        <a class="btn-light mono" href="/writing/"><span>✦</span> {c.primary}</a>
      </div>
    </div>
    <div class="sig-list mono" data-signals="down">
      <div class="sig-window"><ul>{[...c.signals, ...c.signals].map(([a, b]) => <li><i></i>{a} <span class="dim">/ {b}</span></li>)}</ul></div>
    </div>
  </div>
</section>
